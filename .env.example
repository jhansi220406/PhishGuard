# ==============================================================================
# PhishGuard — Environment Configuration Template
# Copy this file to .env and configure your local settings.
# ==============================================================================

# Server Port
PORT=8080

# Active Spring Profile (Set to 'mysql' for native MySQL, or omit for default smart H2-MySQL mode)
# SPRING_PROFILES_ACTIVE=mysql

# Database Connection Settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phishguard
DB_USER=root
DB_PASS=your_mysql_password_here

# Full Spring Datasource overrides (optional)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/phishguard?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Stateless Authentication Secret & Expiration
JWT_SECRET=PhishGuardEnterpriseSecretKeyForCyberDefensePlatformTokenSigning2026!
JWT_EXPIRATION_MS=86400000

# Optional External Threat Intelligence APIs
# Leave blank to run in resilient offline heuristic fallback mode
VIRUSTOTAL_API_KEY=
SAFEBROWSING_API_KEY=
